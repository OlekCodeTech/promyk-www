# PROMYK — statyczna strona (home.pl / LiteSpeed)
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

RewriteEngine On

# wymuszenie HTTPS i domeny bez www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://promyk.wielun.pl/$1 [R=301,L]

# --- przekierowania ze starych adresów WordPressa (SEO) ---
RewriteRule ^oslony-zewnetrzne/refleksole/$ /oslony-zewnetrzne--refleksole-ziiip-120 [R=301,L]
RewriteRule ^oslony-zewnetrzne/zaluzje-fasadowe/$ /zaluzje-fasadowe [R=301,L]
RewriteRule ^oslony-zewnetrzne/sunbreaker[^/]*/$ /oslony-zewnetrzne--sunbreaker-210 [R=301,L]
RewriteRule ^oslony-zewnetrzne/moskitiery/$ /moskitiery [R=301,L]
RewriteRule ^oslony-zewnetrzne/$ /oslony-zewnetrzne [R=301,L]
RewriteRule ^oslony-wewnetrzne/.*$ /oslony-wewnetrzne [R=301,L]
RewriteRule ^markizy/markizy-tarasowe/$ /markizy--markizy-tarasowe [R=301,L]
RewriteRule ^markizy/markizy-balkonowe/$ /markizy--markizy-balkonowe [R=301,L]
RewriteRule ^markizy/$ /markizy [R=301,L]
RewriteRule ^bramy-garazowe/segmentowe/$ /bramy-garazowe--bramy-segmentowe [R=301,L]
RewriteRule ^bramy-garazowe/rolowane/$ /bramy-garazowe--bramy-rolowane [R=301,L]
RewriteRule ^bramy-garazowe/$ /bramy-garazowe [R=301,L]
RewriteRule ^pergole/.*$ /pergole [R=301,L]
RewriteRule ^rolety-zewnetrzne/.*$ /rolety-zewnetrzne [R=301,L]
RewriteRule ^drzwi/drzwi-wewnetrzne/$ /drzwi-wewnetrzne [R=301,L]
RewriteRule ^drzwi/drzwi-zewnetrzne/$ /drzwi-zewnetrzne [R=301,L]
RewriteRule ^drzwi/$ /drzwi-zewnetrzne [R=301,L]
RewriteRule ^okna/parapety/$ /parapety [R=301,L]
RewriteRule ^okna/.*$ /okna [R=301,L]
RewriteRule ^category/okna/$ /okna [R=301,L]
RewriteRule ^category/drzwi/$ /oferta [R=301,L]
RewriteRule ^category/(rolety-zewnetrzne|pergole|bramy-garazowe|markizy|oslony-wewnetrzne|oslony-zewnetrzne)/$ /$1 [R=301,L]
RewriteRule ^category/.*$ /oferta [R=301,L]
RewriteRule ^(galeria|dla-inwestora|kontakt|polityka-prywatnosci|o-nas|oferta|konfigurator)/$ /$1 [R=301,L]
RewriteRule ^(wp-sitemap|sitemap_index|page-sitemap|post-sitemap)[^/]*\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(author|wp-admin|wp-login\.php|wp-content|wp-includes|feed|comments)(/.*)?$ / [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(da_image|p|page_id)= [NC]
RewriteRule ^$ /? [R=301,L]

# --- ładne adresy: /okna zamiast /okna.html, / zamiast /index.html ---
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
RewriteCond %1 !^(google|404)
RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)$ /$1.html [L]

# --- cache przeglądarki (CSS/JS mają wersję ?v=, obrazy rzadko się zmieniają)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# nie udostępniaj plików roboczych
<FilesMatch "\.(py|md|zip)$">
  Require all denied
</FilesMatch>
